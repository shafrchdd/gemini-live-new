                                  <block type="logic_boolean" id="gl_37">
                                    <field name="BOOL">TRUE</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="component_method" id="gl_39">
                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="ClearFunctions" is_generic="false" />
                                    <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                    <next>
                                      <block type="component_method" id="gl_15">
                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="AddFunction" is_generic="false" />
                                        <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                        <value name="ARG0">
                                          <block type="text" id="gl_12">
                                            <field name="TEXT">buddy_set_emotion</field>
                                          </block>
                                        </value>
                                        <value name="ARG1">
                                          <block type="text" id="gl_13">
                                            <field name="TEXT">Set the persistent avatar emotion to match the user request. Return success only after the application applies it.</field>
                                          </block>
                                        </value>
                                        <value name="ARG2">
                                          <block type="text" id="gl_14">
                                            <field name="TEXT">{"type":"object","properties":{"emotion":{"type":"string","enum":["idle","happy","excited","sad","angry","bored","curious","confused","shy","love","surprised","scared","proud","guilty","jealous","disgusted","frustrated","calm","sleepy","dizzy","mischievous","focused","embarrassed","grateful","crying","sleeping"]}},"required":["emotion"]}</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="component_method" id="gl_19">
                                            <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="AddFunction" is_generic="false" />
                                            <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                            <value name="ARG0">
                                              <block type="text" id="gl_16">
                                                <field name="TEXT">buddy_play_reaction</field>
                                              </block>
                                            </value>
                                            <value name="ARG1">
                                              <block type="text" id="gl_17">
                                                <field name="TEXT">Play a temporary avatar gesture for 3 seconds without replacing the base emotion. Use when the user requests an action.</field>
                                              </block>
                                            </value>
                                            <value name="ARG2">
                                              <block type="text" id="gl_18">
                                                <field name="TEXT">{"type":"object","properties":{"reaction":{"type":"string","enum":["wave","nod","shake_head","laugh","giggle","clap","dance","jump","celebrate","facepalm","wink","blow_kiss","hug","think","peek","stretch","yawn","sneeze","hiccup","fall","get_up","spin","shrug","point","look_around","listen_closely","cheer","sleep"]}},"required":["reaction"]}</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="component_set_get" id="gl_42">
                                                <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" property_name="Model" set_or_get="set" is_generic="false" />
                                                <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                <field name="PROP">Model</field>
                                                <value name="VALUE">
                                                  <block type="text_trim" id="gl_41">
                                                    <field name="MODE">BOTH</field>
                                                    <value name="TEXT">
                                                      <block type="component_set_get" id="gl_40">
                                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" instance_name="ModelInput" property_name="Text" set_or_get="get" is_generic="false" />
                                                        <field name="COMPONENT_SELECTOR">ModelInput</field>
                                                        <field name="PROP">Text</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="component_set_get" id="gl_44">
                                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" property_name="SystemInstruction" set_or_get="set" is_generic="false" />
                                                    <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                    <field name="PROP">SystemInstruction</field>
                                                    <value name="VALUE">
                                                      <block type="text" id="gl_43">
                                                        <field name="TEXT">You are a cute cyan-eyed desk buddy. Use buddy_set_emotion for requested emotions and buddy_play_reaction for requested gestures. For requests with both, call both functions. Wait for actual function results before claiming success. Keep replies brief, in Malayalam or English matching the user. Do not speak tool names or JSON.</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="component_set_get" id="gl_46">
                                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" instance_name="StatusLabel" property_name="Text" set_or_get="set" is_generic="false" />
                                                        <field name="COMPONENT_SELECTOR">StatusLabel</field>
                                                        <field name="PROP">Text</field>
                                                        <value name="VALUE">
                                                          <block type="text" id="gl_45">
                                                            <field name="TEXT">Connecting…</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="component_method" id="gl_49">
                                                            <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="Connect" is_generic="false" />
                                                            <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                            <value name="ARG0">
                                                              <block type="text_trim" id="gl_48">
                                                                <field name="MODE">BOTH</field>
                                                                <value name="TEXT">
                                                                  <block type="component_set_get" id="gl_47">
                                                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" instance_name="KeyInput" property_name="Text" set_or_get="get" is_generic="false" />
                                                                    <field name="COMPONENT_SELECTOR">KeyInput</field>
                                                                    <field name="PROP">Text</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
