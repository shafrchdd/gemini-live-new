                            <next>
                              <block type="component_set_get" id="gl_38">
                                <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Button" instance_name="DisconnectButton" property_name="Enabled" set_or_get="set" is_generic="false" />
                                <field name="COMPONENT_SELECTOR">DisconnectButton</field>
