                                <value name="VALUE">
                                  <block type="logic_boolean" id="gl_37">
                                    <field name="BOOL">TRUE</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="component_method" id="gl_39">
                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="ClearFunctions" is_generic="false" />
                                    <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                    <next>
                                      <block type="component_method" id="gl_15">
                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="AddFunction" is_generic="false" />
                                        <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                        <value name="ARG0">
                                          <block type="text" id="gl_12">
                                            <field name="TEXT">buddy_set_emotion</field>
                                          </block>
                                        </value>
                                        <value name="ARG1">
                                          <block type="text" id="gl_13">
                                            <field name="TEXT">Silently express the conversational mood through the avatar. Use naturally when the mood changes, without waiting for an explicit user request. Never announce the face change or its result.</field>
                                          </block>
                                        </value>
                                        <value name="ARG2">
                                          <block type="text" id="gl_14">
                                            <field name="TEXT">{"type":"object","properties":{"emotion":{"type":"string","enum":["idle","happy","excited","sad","angry","bored","curious","confused","shy","love","surprised","scared","proud","guilty","jealous","disgusted","frustrated","calm","sleepy","dizzy","mischievous","focused","embarrassed","grateful","crying","sleeping"]}},"required":["emotion"]}</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="component_method" id="gl_19">
                                            <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="AddFunction" is_generic="false" />
                                            <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                            <value name="ARG0">
                                              <block type="text" id="gl_16">
                                                <field name="TEXT">buddy_play_reaction</field>
                                              </block>
                                            </value>
                                            <value name="ARG1">
                                              <block type="text" id="gl_17">
                                                <field name="TEXT">Silently add an occasional fitting gesture to conversation, such as a greeting wave or celebration. Never narrate the gesture or acknowledge its execution result.</field>
                                              </block>
                                            </value>
                                            <value name="ARG2">
                                              <block type="text" id="gl_18">
                                                <field name="TEXT">{"type":"object","properties":{"reaction":{"type":"string","enum":["wave","nod","shake_head","laugh","giggle","clap","dance","jump","celebrate","facepalm","wink","blow_kiss","hug","think","peek","stretch","yawn","sneeze","hiccup","fall","get_up","spin","shrug","point","look_around","listen_closely","cheer","sleep"]}},"required":["reaction"]}</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="component_set_get" id="gl_42">
                                                <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" property_name="Model" set_or_get="set" is_generic="false" />
                                                <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                <field name="PROP">Model</field>
                                                <value name="VALUE">
                                                  <block type="text_trim" id="gl_41">
                                                    <field name="MODE">BOTH</field>
                                                    <value name="TEXT">
                                                      <block type="component_set_get" id="gl_40">
                                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" instance_name="ModelInput" property_name="Text" set_or_get="get" is_generic="false" />
                                                        <field name="COMPONENT_SELECTOR">ModelInput</field>
                                                        <field name="PROP">Text</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="component_set_get" id="gl_44">
                                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" property_name="SystemInstruction" set_or_get="set" is_generic="false" />
                                                    <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                    <field name="PROP">SystemInstruction</field>
                                                    <value name="VALUE">
                                                      <block type="text" id="gl_43">
                                                        <field name="TEXT">You are a warm, playful desk companion with a cute cyan-eyed avatar. Have a natural conversation with the user; answer their message rather than narrating your interface.

Your avatar expresses your conversational mood automatically. Use buddy_set_emotion when the mood changes, even when the user has not asked for an expression. Choose happy for pleasant exchanges, excited for good news, curious when exploring, focused when helping solve a problem, calm for ordinary support, and a gentle sad expression when responding compassionately. Stay proportionate; do not turn every sentence into a dramatic emotion. Use buddy_play_reaction occasionally for a fitting gesture: wave for a greeting or goodbye, nod for agreement, laugh or giggle for a light joke, cheer or celebrate for an achievement, think for a thoughtful moment. These are visual stage directions, not topics of conversation. Do not issue the same emotion repeatedly when it has not changed. Do not repeat a gesture after receiving its result.

Never announce an avatar action or function execution. Do not say “I changed my face,” “I am smiling now,” “I activated happy mode,” “the reaction succeeded,” or similar descriptions. Do not speak tool names, JSON, status fields, animation durations or success acknowledgments. Function results are internal feedback: use them to know whether the visual action happened, then continue your ordinary answer. If a visual tool fails, continue the conversation without a technical announcement unless the user specifically asks about the avatar problem. Do not claim an unsuccessful action happened.

For “Hi,” a suitable response is “Hey! How’s your day going?” accompanied by a happy expression and, occasionally, a wave—not “I changed my face to happy and waved.” For “I passed my exam,” congratulate the user naturally with an excited expression or celebration. For “I’m having a hard day,” respond gently, without joking or exaggerated crying. If the user explicitly requests a smile or gesture, perform it and keep any spoken reply brief and conversational; do not report the execution.

Keep most spoken replies to one to three short sentences. Reply in Malayalam or English matching the user's language. Listen to their actual request, ask useful questions, and do not invent information. Avatar reactions should support the conversation, never replace the answer or pressure the user.
</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="component_set_get" id="gl_46">
                                                        <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" instance_name="StatusLabel" property_name="Text" set_or_get="set" is_generic="false" />
                                                        <field name="COMPONENT_SELECTOR">StatusLabel</field>
                                                        <field name="PROP">Text</field>
                                                        <value name="VALUE">
                                                          <block type="text" id="gl_45">
                                                            <field name="TEXT">Connecting…</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="component_method" id="gl_49">
                                                            <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="GeminiLive" instance_name="GeminiLive1" method_name="Connect" is_generic="false" />
                                                            <field name="COMPONENT_SELECTOR">GeminiLive1</field>
                                                            <value name="ARG0">
                                                              <block type="text_trim" id="gl_48">
                                                                <field name="MODE">BOTH</field>
                                                                <value name="TEXT">
                                                                  <block type="component_set_get" id="gl_47">
                                                                    <mutation xmlns="http://www.w3.org/1999/xhtml" component_type="TextBox" instance_name="KeyInput" property_name="Text" set_or_get="get" is_generic="false" />
                                                                    <field name="COMPONENT_SELECTOR">KeyInput</field>
                                                                    <field name="PROP">Text</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
